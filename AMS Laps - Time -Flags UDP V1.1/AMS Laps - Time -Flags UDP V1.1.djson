{"Variables":{"DashboardVariables":[{"VariableName":"GameSessionStates","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"JSExt":0,"Interpreter":1,"Expression":"const Game = NewRawData().sGameStateData.mGameState; // This line simulates fetching the game state data\r\n\r\n// Extract the game state and session state using the updated bit positions\r\nconst gameState = Game & 0x0F; // 0x0F is 00001111 in binary, masking the first 4 bits\r\nconst sessionState = (Game >> 4) & 0x0F; // Shift right by 4 and then mask with 0x0F to get the next 4 bits\r\n\r\n// Convert the mGameState byte to a binary string\r\nconst gameStateBinary = Game.toString(2).padStart(8, '0'); // Ensures 8-bit representation\r\n\r\n// Lookup human-readable states\r\nconst gameStateString = GameState[gameState];\r\nconst sessionStateString = SessionState[sessionState];\r\n\r\n// Construct and return the combined string with binary representation\r\n//return `Binary: ${gameStateBinary} | Game State: ${gameStateString} | Session State: ${sessionStateString}`;\r\n\r\nreturn {\r\n  gameState: gameStateString,\r\n  sessionState: sessionStateString\r\n};\r\n","PreExpression":"// Define the game state and session state enums\r\nconst GameState = {\r\n  0: \"GAME_EXITED\",\r\n  1: \"GAME_FRONT_END\",\r\n  2: \"GAME_INGAME_PLAYING\",\r\n  3: \"GAME_INGAME_PAUSED\",\r\n  4: \"GAME_INGAME_INMENU_TIME_TICKING\",\r\n  5: \"GAME_INGAME_RESTARTING\",\r\n  6: \"GAME_INGAME_REPLAY\",\r\n  7: \"GAME_FRONT_END_REPLAY\",\r\n  // Add more if there are more than 8 game states, given the new 4-bit range\r\n};\r\n\r\nconst SessionState = {\r\n  0: \"SESSION_INVALID\",\r\n  1: \"SESSION_PRACTICE\",\r\n  2: \"SESSION_TEST\",\r\n  3: \"SESSION_QUALIFY\",\r\n  4: \"SESSION_FORMATION_LAP\",\r\n  5: \"SESSION_RACE\",\r\n  6: \"SESSION_TIME_ATTACK\",\r\n  // Add more if needed, since we now have 4 bits for session states allowing up to 16 values\r\n};"},"EvaluateBeforeScreenRoles":false},{"VariableName":"driverData","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"JSExt":0,"Interpreter":1,"Expression":"var rawData = NewRawData();\r\nvar participantsStats = rawData.sTimeStatsData.sStats.sParticipants;\r\nvar timingData = rawData.sTimingsData.sParticipants;\r\nvar participantsInfo = rawData.ParticipantsData;\r\nvar driverData = [];\r\n\r\n// Before the loop, determine who has the highest score\r\nlet highestScore = -Infinity;\r\nlet inFocusDriverNumber = null;\r\n\r\nfor (const [driverNum, driverScore] of Object.entries(root[\"scores\"])) {\r\n    if (driverScore > highestScore) {\r\n        highestScore = driverScore;\r\n        inFocusDriverNumber = driverNum;\r\n    }\r\n}\r\n// Mark the driver with the highest score for camera focus\r\nif (inFocusDriverNumber !== null) {\r\n    root[\"inFocus\"] = inFocusDriverNumber;\r\n}\r\n// Assuming inFocusDriverNumber is determined from your score logic\r\nif (inFocusDriverNumber !== root[\"inFocusInfo\"].driverNumber) {\r\n    root[\"inFocusInfo\"].driverNumber = inFocusDriverNumber;\r\n    root[\"inFocusInfo\"].focusStartTime = Date.now();\r\n    // Whenever a new driver comes into focus, reset scores as needed\r\n}\r\n\r\nfor (var driverNumber = 0; driverNumber <= 31; driverNumber++) {\r\n    var participant = participantsStats[driverNumber];\r\n    var timing = timingData[driverNumber];\r\n    var participantInfo = participantsInfo[driverNumber];\r\n    var score = 0;\r\n    var racePosition = timing.sRacePosition & 0x7F;\r\n    var isActive = (timing.sRacePosition & 0x80) !== 0;\r\n\r\n    if (isActive) {\r\n        let currentSectorCorrected = timing.Sector + 1;\r\n        var previousSectorIndex = (currentSectorCorrected - 1) % 3 === 0 ? 3 : (currentSectorCorrected - 1) % 3;\r\n        let isInPitLane = driveriscarinpitlane(racePosition);\r\n        var currentLap = timing.sCurrentLap;\r\n        \r\n        \r\n// Check if the driver's sector times are not negative\r\n        if (participant.sFastestSector1Time >= 0 && participant.sFastestSector2Time >= 0 && participant.sFastestSector3Time >= 0) {\r\n            // Update global fastest sector times if applicable\r\n            if (participant.sFastestSector1Time < root[\"globalFastestSectorTimes\"][0]) {\r\n                root[\"globalFastestSectorTimes\"][0] = participant.sFastestSector1Time;\r\n            }\r\n            if (participant.sFastestSector2Time < root[\"globalFastestSectorTimes\"][1]) {\r\n                root[\"globalFastestSectorTimes\"][1] = participant.sFastestSector2Time;\r\n            }\r\n            if (participant.sFastestSector3Time < root[\"globalFastestSectorTimes\"][2]) {\r\n                root[\"globalFastestSectorTimes\"][2] = participant.sFastestSector3Time;\r\n            }\r\n        }\r\n        \r\n        // Update global fastest holders if the driver's last sector time is better than global fastest\r\n        if (participant.sLastSectorTime >= 0) {\r\n    // Check the driver's last sector time against the global fastest time of the previous sector\r\n    var previousSectorIndex = timing.Sector - 1;\r\n    if (participant.sLastSectorTime < root[\"globalFastestSectorTimes\"][previousSectorIndex]) {\r\n        // Check if the driver is already holding the record for the previous sector in this lap\r\n        var driverAlreadyHoldingRecord = root[\"globalFastestHolders\"].some(holder => holder.index === driverNumber && holder.sector === previousSectorIndex && holder.lap === currentLap);\r\n        if (!driverAlreadyHoldingRecord) {\r\n            // Push a new object into the globalFastestHolders array\r\n            root[\"globalFastestHolders\"].push({ index: driverNumber, lap: currentLap, sector: previousSectorIndex });\r\n        }\r\n    } \r\n}\r\n// Check against personal best sector times\r\n\t\tlet sectorPropertyName = `sFastestSector${previousSectorIndex + 1}Time`;\r\n        if (participant[sectorPropertyName] !== undefined && participant.sLastSectorTime < participant[sectorPropertyName] && participant.sLastSectorTime >= 0) {\r\n    // Determine if the driver is already recorded for this lap and sector\r\n    let driverExists = root[\"personalFastestSectors\"].some(entry => \r\n        entry.index === driverNumber && \r\n        entry.lap === currentLap && \r\n        entry.sector === previousSectorIndex);\r\n\r\n    if (!driverExists) {\r\n        // If the last sector time is equal or better, and driver is not already recorded for this lap and sector, add to personalFastestSectors\r\n        root[\"personalFastestSectors\"].push({\r\n            index: driverNumber, \r\n            lap: currentLap, \r\n            sector: previousSectorIndex, \r\n            time: participant.sLastSectorTime\r\n        });\r\n    }\r\n}\r\n// Housekeeping: Removing old entries for both global and personal bests\r\n// This ensures that entries for previous laps are cleared, maintaining accuracy\r\nroot[\"globalFastestHolders\"] = root[\"globalFastestHolders\"].filter(holder => \r\n    !(holder.index === driverNumber && holder.sector === previousSectorIndex && holder.lap < currentLap));\r\n\r\nroot[\"personalFastestSectors\"] = root[\"personalFastestSectors\"].filter(entry => \r\n    !(entry.index === driverNumber && entry.sector === previousSectorIndex && entry.lap < currentLap));\r\n\r\n        // Deduct points if the driver is in the pit lane\r\nif (isInPitLane) {\r\n    score -= 30;\r\n} else {\r\n    // Add 5 points for every time they are in the globalFastestHolders array\r\n    root[\"globalFastestHolders\"].forEach(holder => {\r\n        if (holder.index === driverNumber) {\r\n            score += 5;\r\n        }\r\n    });\r\n\t// Add 5 points for every time they are in the personalFastestSectors array \r\n    root[\"personalFastestSectors\"].forEach(holder => {\r\n        if (holder.index === driverNumber) {\r\n            score += 5;\r\n        }\r\n    });   \r\n}\r\n//No Lap Time is more interesting\r\nif (participant.sLastLapTime <=0) {\r\n    score += 5;\r\n}\r\n//Leaders are more interesting\r\n    const numParticipants = Object.keys(root[\"scores\"]).length;\r\n    const baseScoreValue = numParticipants / 4;\r\n    score += baseScoreValue - racePosition;\r\n    \r\n//Do not allow camera to dwell\r\nif (root[\"inFocusInfo\"].driverNumber ==driverNumber) {\r\n    const now = Date.now();\r\n    const focusDurationSeconds = (now - root[\"inFocusInfo\"].focusStartTime) / 1000; // Convert milliseconds to seconds\r\n     root[\"inFocusInfo\"].racePosition = racePosition;\r\n\r\n    if (focusDurationSeconds <= 15) {\r\n        // If in focus for less than or equal to 15 seconds, ensure the driver gets 4 bonus points\r\n        score += 4; // This adds 4 points each time it's checked, needs control to add once\r\n    } else {\r\n        // After 15 seconds, start subtracting points based on how long they've been in focus\r\n        const pointsToSubtract = Math.floor(focusDurationSeconds - 15); // Calculate extra seconds past the first 15\r\n        score -= pointsToSubtract;        \r\n    }\r\n}\r\n        root[\"scores\"][driverNumber] = score;\r\n        driverData[driverNumber] = {\r\n            name: participantInfo.Name,\r\n            nationality: participantInfo.Nationality,\r\n            index: participantInfo.sIndex,\r\n            fastestSector1Time: participant.sFastestSector1Time,\r\n            fastestSector2Time: participant.sFastestSector2Time,\r\n            fastestSector3Time: participant.sFastestSector3Time,\r\n            lastSectorTime: participant.sLastSectorTime,\r\n            currentSector: currentSectorCorrected,\r\n            racePosition: racePosition,\r\n            isInPitLane: isInPitLane,\r\n            isActive: isActive,\r\n            currentSectorTime: timing.sCurrentSectorTime,\r\n            currentTime: timing.sCurrentTime,\r\n            fastestLapTime: participant.sFastestLapTime,\r\n            lastLapTime: participant.sLastLapTime,\r\n            currentLap: currentLap,\r\n            score: score,            \r\n        };\r\n    }\r\n}\r\n\r\nroot[\"driverData\"] = driverData.filter(Boolean);\r\nvar result = {\r\n    driverData: root[\"driverData\"], // Your processed driver data\r\n    globalFastestHolders: root[\"globalFastestHolders\"], // Current holders of the fastest lap times\r\n    globalFastestSectorTimes: root[\"globalFastestSectorTimes\"] // Fastest times for each sector\r\n    driverCurrentLapSectorTimes: root[\"driverLapSectorTimes\"]\r\n};\r\n//return JSON.stringify(root[\"globalFastestHolders\"]);\r\n//return JSON.stringify(root[\"personalFastestSectors\"]);\r\n//return JSON.stringify(driverData.filter(Boolean), null, 2);\r\nreturn result;\r\n//return JSON.stringify(root[\"scores\"]);\r\n//return root[\"inFocusInfo\"].racePosition","PreExpression":"if (!root[\"globalFastestSectorTimes\"]) {\r\n    root[\"globalFastestSectorTimes\"] = [Infinity, Infinity, Infinity];\r\n}\r\nif (!root[\"personalFastestSectors\"]) {\r\n    root[\"personalFastestSectors\"] = [];\r\n}\r\n\r\nif (!root[\"globalFastestHolders\"]) {\r\n    root[\"globalFastestHolders\"] = Array.from({ length: 3 }, () => ({ index: null, lap: null, awarded: false }));\r\n}\r\nif (!root[\"scores\"]) {\r\n    root[\"scores\"] = [];\r\n}\r\nif (!root[\"driverData\"]) {\r\n    root[\"driverData\"] = [];\r\n}\r\nif (!root[\"inFocusInfo\"]) {\r\n    root[\"inFocusInfo\"] = { driverNumber: null, focusStartTime: null };\r\n}\r\n\r\n     "},"EvaluateBeforeScreenRoles":false},{"VariableName":"driverInView","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"JSExt":0,"Interpreter":1,"Expression":"var DriverInView = NewRawData().sTelemetryData.sViewedParticipantIndex;\r\nvar stuff = NewRawData().ParticipantsData[DriverInView]; // Use DriverInView\r\nvar name = stuff.Name; //extract name from structure\r\n//return JSON.stringify(stuff);\r\nreturn name"},"EvaluateBeforeScreenRoles":false},{"VariableName":"rxUDP","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"JSExt":0,"Interpreter":1,"Expression":"var test = driveravailable(1)\r\nreturn test"},"EvaluateBeforeScreenRoles":false}]},"DashboardDebugManager":{"WindowPositionSettings":{"IsFullScreen":true,"Position":"362,231,2052,1155","TopMost":false,"AllowTransparency":true,"CloseOnMonitorLoss":false,"NoWindowActivate":false}},"Version":2,"Id":"ff0c9608-e160-4ed6-af9d-7a8e34d7c0bc","BaseHeight":1080,"BaseWidth":1920,"BackgroundColor":"#FF000000","Screens":[{"RenderingSkip":0,"Name":"Screen","InGameScreen":true,"IdleScreen":false,"PitScreen":false,"ScreenId":"1c68c66a-2ab7-4aaf-9b18-5a725e1f6a76","AllowOverlays":true,"IsForegroundLayer":false,"IsOverlayLayer":false,"OverlayTriggerExpression":{"Expression":""},"ScreenEnabledExpression":{"JSExt":0,"Interpreter":1,"Expression":""},"OverlayMaxDuration":0,"OverlayMinDuration":0,"IsBackgroundLayer":false,"BackgroundColor":"#00FFFFFF","Items":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.Layer, SimHub.Plugins","Group":false,"Repetitions":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.GradientItem, SimHub.Plugins","Color":{"LinearGradientBrush":{"@StartPoint":"1,0","@EndPoint":"-1,0","@MappingMode":"RelativeToBoundingBox","@SpreadMethod":"Pad","@Opacity":"1","@xmlns":"http://schemas.microsoft.com/winfx/2006/xaml/presentation","LinearGradientBrush.GradientStops":{"GradientStop":[{"@Color":"#FF000000","@Offset":"1"},{"@Color":"#FF8C8C8C","@Offset":"0"}]}}},"BackgroundColor":"#00FFFFFF","BorderStyle":{"RadiusTopLeft":18,"RadiusTopRight":18,"RadiusBottomLeft":18,"RadiusBottomRight":18},"Height":132.0,"Left":1678.0,"Opacity":60.0,"Top":208.0,"Visible":false,"Width":100.0,"Name":"GradientItem","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.GroupItem, SimHub.Plugins","ChildsPositioning":0,"ChildsPositioningAlignment":0,"GroupPadding":{},"ChildsMargin":{},"ChildAlignmentHorizontal":0,"ChildAlignmentVertical":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Secular One","FontSize":22.0,"Text":"Time","TextColor":"#FF808080","HorizontalAlignment":0,"VerticalAlignment":0,"BackgroundColor":"#00FFFFFF","Height":47.0,"Left":19.0,"Top":-1.0,"Visible":true,"Width":101.0,"Name":"TextItem3","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"var totalLaps = $prop('TotalLaps')\r\nvar thisLap = drivercurrentlap(1)\r\nvar timeLeft = $prop('SessionTimeLeft')\r\n// Destructure the properties from the object\r\nvar { gameState, sessionState } = $prop('variable.GameSessionStates');\r\nvar info = $prop('GameRawData.sRaceData.sLapsTimeInEvent');\r\nvar isTimedSession = (info & 0x8000) !== 0;\r\nvar value = info & 0x7FFF;\r\n\r\nif(sessionState == \"SESSION_PRACTICE\"){\r\nreturn \"Time\";\r\n}\r\nif(sessionState == \"SESSION_QUALIFY\"){\r\nreturn \"Time\";\r\n}\r\nif(isTimedSession == true){\r\nreturn \"Time\";\r\n}\r\nreturn \"Laps\""},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Secular One","FontSize":40.0,"Text":"Text","TextColor":"#FFFFFFFF","HorizontalAlignment":0,"VerticalAlignment":0,"BackgroundColor":"#00FFFFFF","Height":47.0,"Left":10.0,"Top":82.0,"Visible":true,"Width":80.0,"Name":"TextItem2","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"FormatString":"ss","Formula":{"JSExt":0,"Interpreter":1,"Expression":"var totalLaps = $prop('TotalLaps')\r\nvar thisLap = drivercurrentlap(1)\r\nvar timeLeft = $prop('SessionTimeLeft')\r\n// Destructure the properties from the object\r\nvar { gameState, sessionState } = $prop('variable.GameSessionStates');\r\nvar info = $prop('GameRawData.sRaceData.sLapsTimeInEvent');\r\nvar isTimedSession = (info & 0x8000) !== 0;\r\nvar value = info & 0x7FFF;\r\n\r\nif(sessionState == \"SESSION_PRACTICE\"){\r\nreturn timeLeft;\r\n}\r\nif(sessionState == \"SESSION_QUALIFY\"){\r\nreturn timeLeft;\r\n}\r\nif(isTimedSession == true){\r\nreturn timeLeft;\r\n}\r\nvar lapsRemaining = $prop('TotalLaps')\r\nreturn secondstotimespan(lapsRemaining)"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins","IsRectangleItem":true,"BackgroundColor":"#FFFF0000","BorderStyle":{"RadiusTopLeft":4,"RadiusTopRight":4,"RadiusBottomLeft":4,"RadiusBottomRight":4},"Height":5.0,"Left":10.0,"Top":74.0,"Visible":true,"Width":80.0,"Name":"RectangleItem","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Secular One","FontSize":40.0,"Text":"Text","TextColor":"#FFFFFFFF","HorizontalAlignment":0,"VerticalAlignment":0,"BackgroundColor":"#00FFFFFF","Height":47.0,"Left":10.0,"Top":21.0,"Visible":true,"Width":80.0,"Name":"TextItem","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"FormatString":"mm","Formula":{"JSExt":0,"Interpreter":1,"Expression":"var totalLaps = $prop('TotalLaps')\r\nvar thisLap = drivercurrentlap(1)\r\nvar timeLeft = $prop('SessionTimeLeft')\r\n// Destructure the properties from the object\r\nvar { gameState, sessionState } = $prop('variable.GameSessionStates');\r\nvar info = $prop('GameRawData.sRaceData.sLapsTimeInEvent');\r\nvar isTimedSession = (info & 0x8000) !== 0;\r\nvar value = info & 0x7FFF;\r\n\r\nif(sessionState == \"SESSION_PRACTICE\"){\r\nreturn timeLeft;\r\n}\r\nif(sessionState == \"SESSION_QUALIFY\"){\r\nreturn timeLeft;\r\n}\r\nif(isTimedSession == true){\r\nreturn timeLeft;\r\n}\r\nreturn secondstotimespan(drivercurrentlap(1) * 60)"},"Mode":2}}}],"BackgroundColor":"#00FFFFFF","Height":131.0,"Left":1678.0,"Top":208.0,"Visible":false,"Width":105.0,"Name":"GroupItem","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0}],"Visible":false,"Name":"Time & Laps","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"var laps = $prop('TotalLaps')\r\nvar time = timespantoseconds($prop('SessionTimeLeft'))\r\nif(laps + time >0){\r\nreturn 1;\r\n}\r\nreturn 0;"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.GroupItem, SimHub.Plugins","ChildsPositioning":0,"ChildsPositioningAlignment":0,"GroupPadding":{},"ChildsMargin":{},"ChildAlignmentHorizontal":0,"ChildAlignmentVertical":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.Layer, SimHub.Plugins","Group":false,"Repetitions":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.GroupItem, SimHub.Plugins","ChildsPositioning":0,"ChildsPositioningAlignment":0,"GroupPadding":{},"ChildsMargin":{},"ChildAlignmentHorizontal":0,"ChildAlignmentVertical":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.ImageItem, SimHub.Plugins","Image":"time","AutoSize":false,"BackgroundColor":"#00FFFFFF","Height":128.0,"Left":0.0,"Opacity":95.0,"Top":0.0,"Visible":true,"Width":81.0,"Name":"ImageItem3","RenderingSkip":100,"MinimumRefreshIntervalMS":1000.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Secular One","FontSize":18.0,"Text":"Time","TextColor":"#FFD3D3D3","HorizontalAlignment":1,"VerticalAlignment":0,"BackgroundColor":"#00FFFFFF","Height":47.0,"Left":0.0,"Top":0.0,"Visible":true,"Width":80.0,"Name":"Time or Laps","RenderingSkip":100,"MinimumRefreshIntervalMS":1000.0,"Bindings":{"Text":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"var totalLaps = $prop('TotalLaps')\r\nvar thisLap = drivercurrentlap(1)\r\nvar timeLeft = $prop('SessionTimeLeft')\r\n// Destructure the properties from the object\r\nvar { gameState, sessionState } = $prop('variable.GameSessionStates');\r\nvar info = $prop('GameRawData.sRaceData.sLapsTimeInEvent');\r\nvar isTimedSession = (info & 0x8000) !== 0;\r\nvar value = info & 0x7FFF;\r\n\r\nif(sessionState == \"SESSION_PRACTICE\"){\r\nreturn \"Time\";\r\n}\r\nif(sessionState == \"SESSION_QUALIFY\"){\r\nreturn \"Time\";\r\n}\r\nif(isTimedSession == true){\r\nreturn \"Time\";\r\n}\r\nreturn \"Laps\""},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Secular One","FontSize":35.0,"Text":"20","TextColor":"#FFFFFFFF","HorizontalAlignment":1,"VerticalAlignment":0,"UseMonospacedText":true,"CharWidth":22.0,"BackgroundColor":"#00FFFFFF","Height":47.0,"Left":0.0,"Top":70.0,"Visible":true,"Width":80.0,"Name":"Total Laps","RenderingSkip":100,"MinimumRefreshIntervalMS":1000.0,"Bindings":{"Text":{"FormatString":"ss","Formula":{"JSExt":0,"Interpreter":1,"Expression":"var totalLaps = $prop('TotalLaps')\r\nvar thisLap = drivercurrentlap(1)\r\n//var timeLeft = $prop('SessionTimeLeft')\r\n// NewRawData().sRaceData.sLapsTimeInEvent\r\nvar timeLeft = NewRawData().sTimingsData.sEventTimeRemaining\r\nvar replayTimeLeft = $prop('CurrentLapTime')\r\n\r\n// Destructure the properties from the object\r\nvar { gameState, sessionState } = $prop('variable.GameSessionStates');\r\nvar info = $prop('GameRawData.sRaceData.sLapsTimeInEvent');\r\nvar isTimedSession = (info & 0x8000) !== 0;\r\nvar value = info & 0x7FFF;\r\n\r\nif(sessionState == \"SESSION_PRACTICE\"){\r\nreturn secondstotimespan(timeLeft);\r\n}\r\nif(sessionState == \"SESSION_QUALIFY\"){\r\nreturn secondstotimespan(timeLeft);\r\n}\r\nif(sessionState == \"SESSION_RACE\" && gameState == \"GAME_FRONT_END_REPLAY\"  ){\r\nreturn (replayTimeLeft); //no elapsed ot total event times are available in replay, this is a dirty hack to show something\r\n}\r\nif(isTimedSession == true){\r\nreturn secondstotimespan(timeLeft);\r\n}\r\nvar lapsRemaining = $prop('TotalLaps')\r\nreturn secondstotimespan(lapsRemaining)"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins","IsRectangleItem":true,"BackgroundColor":"#FFFF0000","BorderStyle":{"RadiusTopLeft":4,"RadiusTopRight":4,"RadiusBottomLeft":4,"RadiusBottomRight":4},"Height":5.0,"Left":10.0,"Top":67.0,"Visible":true,"Width":60.0,"Name":"Red Line","RenderingSkip":100,"MinimumRefreshIntervalMS":1000.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Secular One","FontSize":40.0,"Text":"01","TextColor":"#FFFFFFFF","HorizontalAlignment":1,"VerticalAlignment":1,"UseMonospacedText":true,"CharWidth":23.0,"BackgroundColor":"#00FFFFFF","Height":47.0,"Left":0.0,"Top":16.0,"Visible":true,"Width":80.0,"Name":"This Lap","RenderingSkip":10,"MinimumRefreshIntervalMS":100.0,"Bindings":{"Text":{"FormatString":"mm","Formula":{"JSExt":0,"Interpreter":1,"Expression":"var totalLaps = $prop('TotalLaps')\r\nvar thisLap = drivercurrentlap(1)\r\n//var timeLeft = $prop('SessionTimeLeft')\r\nvar timeLeft = NewRawData().sTimingsData.sEventTimeRemaining\r\nvar replayTimeLeft = $prop('CurrentLapTime')\r\n// Destructure the properties from the object\r\nvar { gameState, sessionState } = $prop('variable.GameSessionStates');\r\nvar info = $prop('GameRawData.sRaceData.sLapsTimeInEvent');\r\nvar isTimedSession = (info & 0x8000) !== 0;  // Check if the top bit is set\r\nvar value = info & 0x7FFF;  // Mask out the top bit to get the lap number or the quantized duration\r\nif (isTimedSession) {\r\n    // If it is a timed session, calculate the actual duration in minutes\r\n    var sessionDurationInMinutes = value * 5;  // Each unit in 'value' represents 5 minutes    \r\n} else {\r\n    // If it is not a timed session, 'value' represents the lap number\r\n    var laps = value;\r\n}\r\nif(sessionState == \"SESSION_PRACTICE\"){\r\nreturn secondstotimespan(timeLeft);\r\n}\r\nif(sessionState == \"SESSION_QUALIFY\"){\r\nreturn secondstotimespan(timeLeft);\r\n}\r\nif(sessionState == \"SESSION_RACE\" && gameState == \"GAME_FRONT_END_REPLAY\"  ){\r\nreturn (replayTimeLeft); //no elapsed ot total event times are available in replay, this is a dirty hack to show something\r\n}\r\nif(isTimedSession == true ){\r\nreturn secondstotimespan(timeLeft);\r\n}\r\nreturn secondstotimespan(drivercurrentlap(1) * 60)"},"Mode":2}}}],"BackgroundColor":"#00FFFFFF","Height":128.0,"Left":1.0,"Top":0.0,"Visible":true,"Width":81.0,"Name":"Time or Laps","RenderingSkip":10,"MinimumRefreshIntervalMS":100.0}],"Visible":true,"Name":"New Time and Laps","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.Layer, SimHub.Plugins","Group":false,"Repetitions":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.GroupItem, SimHub.Plugins","ChildsPositioning":0,"ChildsPositioningAlignment":0,"GroupPadding":{},"ChildsMargin":{},"ChildAlignmentHorizontal":0,"ChildAlignmentVertical":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.ImageItem, SimHub.Plugins","Image":"laps","AutoSize":false,"BackgroundColor":"#00FFFFFF","Height":19.0,"Left":0.0,"Opacity":80.0,"Top":0.0,"Visible":true,"Width":115.0,"Name":"ImageItem2","RenderingSkip":100,"MinimumRefreshIntervalMS":1000.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Secular One","TextPadding":{"PaddingLeft":8},"FontSize":13.0,"Text":"Laps","TextColor":"#FFD3D3D3","HorizontalAlignment":0,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":19.0,"Left":0.0,"Top":0.0,"Visible":true,"Width":115.0,"Name":"Total Laps","RenderingSkip":100,"MinimumRefreshIntervalMS":1000.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.RectangleItem, SimHub.Plugins","IsRectangleItem":true,"BackgroundColor":"#FFFF0000","BorderStyle":{"RadiusTopLeft":4,"RadiusTopRight":4,"RadiusBottomLeft":4,"RadiusBottomRight":4},"Height":2.0,"Left":50.0,"Top":9.0,"Visible":