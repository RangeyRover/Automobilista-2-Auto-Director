s","IsRectangleItem":true,"BackgroundColor":"#FF808080","BorderStyle":{"RadiusTopLeft":4,"RadiusTopRight":4,"RadiusBottomLeft":4,"RadiusBottomRight":4},"Height":5.0,"Left":46.0,"Top":67.0,"Visible":true,"Width":40.0,"Name":"Red Line","RenderingSkip":100,"MinimumRefreshIntervalMS":1000.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Secular One","FontSize":22.0,"Text":"10","TextColor":"#FFD3D3D3","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":25.0,"Left":35.0,"Top":83.0,"Visible":true,"Width":61.0,"Name":"All drivers","RenderingSkip":100,"MinimumRefreshIntervalMS":1000.0,"Bindings":{"Text":{"Formula":{"Expression":"[OpponentsCount]"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Secular One","FontSize":18.0,"Text":"Pos.","TextColor":"#FFD3D3D3","HorizontalAlignment":1,"VerticalAlignment":0,"BackgroundColor":"#00FFFFFF","Height":26.0,"Left":35.0,"Top":0.0,"Visible":true,"Width":61.0,"Name":"Position","RenderingSkip":100,"MinimumRefreshIntervalMS":1000.0}],"BackgroundColor":"#00FFFFFF","Height":128.0,"Left":49.0,"Top":0.0,"Visible":true,"Width":98.0,"Name":"Positions","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0}],"Visible":true,"Name":"Position","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0}],"BackgroundColor":"#00FFFFFF","Height":150.0,"Left":1716.0,"Top":181.0,"Visible":true,"Width":147.0,"Name":"Time and Laps","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"var testForData = $prop('variable.rxUDP')\r\nif(testForData == 0 || testForData == null ){\r\nreturn 0;\r\n}\r\nvar GameSessionStates = $prop('variable.GameSessionStates')\r\nvar sessionState = GameSessionStates.sessionState;\r\nvar gameState = GameSessionStates.gameState;\r\n\r\nif (gameState == \"GAME_EXITED\" || gameState == \"GAME_FRONT_END\" || gameState == \"GAME_FRONT_END\" || gameState == \"GAME_INGAME_INMENU_TIME_TICKING\"){\r\nreturn false;\r\n}\r\nif (sessionState == \"SESSION_RACE\" ){\r\nreturn true;\r\n}\r\nreturn false;"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.GroupItem, SimHub.Plugins","ChildsPositioning":0,"ChildsPositioningAlignment":0,"GroupPadding":{},"ChildsMargin":{},"ChildAlignmentHorizontal":0,"ChildAlignmentVertical":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.Layer, SimHub.Plugins","Group":false,"Repetitions":0,"RepeatTopOffset":0.0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Segoe UI","FontSize":20.0,"Text":"Text","TextColor":"#00FFFFFF","HorizontalAlignment":1,"VerticalAlignment":0,"BackgroundColor":"#FFFFFF00","Height":61.0,"Left":0.0,"Top":0.0,"Visible":true,"Width":82.0,"Name":"TextItem","RenderingSkip":50,"MinimumRefreshIntervalMS":500.0,"Bindings":{"BackgroundColor":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"// Ensure persistent storage exists for root, initialize if not.\r\nif (!root[\"persistent\"]) {\r\n    root[\"persistent\"] = {};\r\n}\r\n\r\n// Obtain the current participant index with zero padding if necessary.\r\nvar rep = repeatindex();\r\nvar participantKey = rep < 10 ? `0${rep}` : rep.toString();\r\n\r\n// Retrieve lap distance, race state, and pit mode schedule from game data properties.\r\nvar basePath = `GameRawData.sTimingsData.sParticipants${participantKey}`;\r\nvar distanceLap = $prop(`${basePath}.sCurrentLapDistance`);\r\nvar lap = $prop('CurrentLap');\r\nvar sRaceState = $prop(`${basePath}.sRaceState`);\r\nvar pitByte = $prop(`${basePath}.sPitModeSchedule`);\r\n// Current time for timestamping events.\r\nvar currentTime = Date.now();\r\n\r\n// Parse race state and get pit mode description.\r\nvar result = parseRaceState(sRaceState);\r\nvar pitModeDescription = getPitModeDescription(pitByte);\r\n\r\n// Initialize persistent data for the current participant if not already set.\r\nif (!root[\"persistent\"][rep]) {\r\n    root[\"persistent\"][rep] = {\r\n        driverDistance: distanceLap,\r\n        yellowFlagStart: null,\r\n        firstCheck: true\r\n    };\r\n}\r\n\r\nif (distanceLap === null || (lap == 1 && distanceLap <= 10) || distanceLap <= 0 ||  result.raceState !== \"Racing\" || pitModeDescription !== \"None\") {\t\r\n     root[\"persistent\"][rep].yellowFlagStart = currentTime-20000;\r\n    return \"Transparent\";\r\n}\r\n// Check if the current lap distance matches the last stored distance.\r\nif (distanceLap === root[\"persistent\"][rep].driverDistance) {\r\n    // Start yellow flag timer if not already started.\r\n    if (!root[\"persistent\"][rep].yellowFlagStart) {\r\n        root[\"persistent\"][rep].yellowFlagStart = currentTime;\r\n    }\r\n    // No distance change detected, continue displaying yellow.\r\n    if(currentTime - root[\"persistent\"][rep].yellowFlagStart >10000){\r\n    return \"Transparent\";\r\n    }\r\n    return \"Yellow\";\r\n} else {\r\n\tif(root[\"persistent\"][rep].yellowFlagStart){\r\n    if(currentTime - root[\"persistent\"][rep].yellowFlagStart <10000){\r\n    return \"Yellow\";\r\n    }\r\n    }\r\n    // Reset the yellow flag start time and update distance.\r\n    root[\"persistent\"][rep].yellowFlagStart = null;\r\n    root[\"persistent\"][rep].driverDistance = distanceLap;\r\n    // Distance change detected, return to transparent state.\r\n    return \"Transparent\";\r\n}","PreExpression":"root[\"persistent\"] ={}\r\nroot[\"start\"] = Date.now();\r\nfunction parseRaceState(sRaceState) {\r\n    // Mask to extract the lower 3 bits (race state)\r\n    const raceStateMask = 0x07;\r\n    const raceState = sRaceState & raceStateMask;\r\n\r\n    // Extract the invalidated lap flag from bit 3\r\n    const invalidatedLapFlag = (sRaceState & 0x08) >> 3; // Shift right to get 0 or 1\r\n\r\n    const raceStateDescriptions = [\r\n        \"Invalid\",\r\n        \"Not Started\",\r\n        \"Racing\",\r\n        \"Finished\",\r\n        \"Disqualified\",\r\n        \"Retired\",\r\n        \"DNF\"\r\n    ];\r\n\r\n    return {\r\n        raceState: raceStateDescriptions[raceState] || \"Unknown\",\r\n        invalidatedLap: invalidatedLapFlag === 1 ? \"Yes\" : \"No\"\r\n    };\r\n}\r\nfunction getPitModeDescription(pitByte) {\r\n    // Extract the Pit Mode using bitwise operations (assuming lower 3 bits)\r\n    var pitMode = pitByte & 0x07; // Mask with 00000111\r\n\r\n    // Array of descriptions for each Pit Mode\r\n    const pitModeDescriptions = [\r\n        \"None\",\r\n        \"Driving into Pits\",\r\n        \"In Pit\",\r\n        \"Driving out of Pits\",\r\n        \"In Garage\",\r\n        \"Driving out of Garage\"\r\n    ];\r\n\r\n    // Return just the description of the pit mode\r\n    return pitModeDescriptions[pitMode] || \"Unknown\";\r\n}"},"Mode":2},"Text":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"// Ensure persistent storage exists for root, initialize if not.\r\nif (!root[\"persistent\"]) {\r\n    root[\"persistent\"] = {};\r\n}\r\n\r\n// Obtain the current participant index with zero padding if necessary.\r\nvar rep = repeatindex();\r\nvar participantKey = rep < 10 ? `0${rep}` : rep.toString();\r\n\r\n// Retrieve lap distance, race state, and pit mode schedule from game data properties.\r\nvar basePath = `GameRawData.sTimingsData.sParticipants${participantKey}`;\r\nvar distanceLap = $prop(`${basePath}.sCurrentLapDistance`);\r\nvar sRaceState = $prop(`${basePath}.sRaceState`);\r\nvar pitByte = $prop(`${basePath}.sPitModeSchedule`);\r\nvar lap  = $prop('CurrentLap');\r\n\r\n// Parse race state and get pit mode description.\r\nvar result = parseRaceState(sRaceState);\r\nvar pitModeDescription = getPitModeDescription(pitByte);\r\n\r\n// Initialize persistent data for the current participant if not already set.\r\nif (!root[\"persistent\"][rep]) {\r\n    root[\"persistent\"][rep] = {\r\n        driverDistance: distanceLap,\r\n        yellowFlagStart: null,\r\n        firstCheck: true\r\n    };\r\n}\r\n// Check conditions that might require skipping the current cycle.\r\nif (distanceLap === null || (lap ==1 && distanceLap <= 30) || result.raceState !== \"Racing\" || pitModeDescription !== \"None\") {\r\n\treturn ;\r\n}\r\n\r\n\r\n// Current time for timestamping events.\r\nvar currentTime = Date.now();\r\n\r\n// Check if the current lap distance matches the last stored distance.\r\nif (distanceLap === root[\"persistent\"][rep].driverDistance) {\r\n    // Start yellow flag timer if not already started.\r\n    if (!root[\"persistent\"][rep].yellowFlagStart) {\r\n        root[\"persistent\"][rep].yellowFlagStart = currentTime;\r\n    }\r\n    // No distance change detected, continue displaying yellow.\r\n    return rep;\r\n} else {\r\n    // Reset the yellow flag start time and update distance.\r\n    root[\"persistent\"][rep].yellowFlagStart = null;\r\n    root[\"persistent\"][rep].driverDistance = distanceLap;\r\n    // Distance change detected, return to transparent state.\r\n    return  ;\r\n}","PreExpression":"root[\"persistent\"] ={}\r\nfunction parseRaceState(sRaceState) {\r\n    // Mask to extract the lower 3 bits (race state)\r\n    const raceStateMask = 0x07;\r\n    const raceState = sRaceState & raceStateMask;\r\n\r\n    // Extract the invalidated lap flag from bit 3\r\n    const invalidatedLapFlag = (sRaceState & 0x08) >> 3; // Shift right to get 0 or 1\r\n\r\n    const raceStateDescriptions = [\r\n        \"Invalid\",\r\n        \"Not Started\",\r\n        \"Racing\",\r\n        \"Finished\",\r\n        \"Disqualified\",\r\n        \"Retired\",\r\n        \"DNF\"\r\n    ];\r\n\r\n    return {\r\n        raceState: raceStateDescriptions[raceState] || \"Unknown\",\r\n        invalidatedLap: invalidatedLapFlag === 1 ? \"Yes\" : \"No\"\r\n    };\r\n}\r\nfunction getPitModeDescription(pitByte) {\r\n    // Extract the Pit Mode using bitwise operations (assuming lower 3 bits)\r\n    var pitMode = pitByte & 0x07; // Mask with 00000111\r\n\r\n    // Array of descriptions for each Pit Mode\r\n    const pitModeDescriptions = [\r\n        \"None\",\r\n        \"Driving into Pits\",\r\n        \"In Pit\",\r\n        \"Driving out of Pits\",\r\n        \"In Garage\",\r\n        \"Driving out of Garage\"\r\n    ];\r\n\r\n    // Return just the description of the pit mode\r\n    return pitModeDescriptions[pitMode] || \"Unknown\";\r\n}"},"Mode":2}}}],"Opacity":60.0,"Visible":true,"Name":"Layer","RenderingSkip":50,"MinimumRefreshIntervalMS":500.0,"Bindings":{"Repetitions":{"Formula":{"Expression":"[OpponentsCount]"},"Mode":2}}}],"BackgroundColor":"#00FFFFFF","Height":61.0,"Left":1722.0,"Top":334.0,"Visible":true,"Width":82.0,"Name":"yellowFlag","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"var testForData = $prop('variable.rxUDP')\r\nif(testForData == 0 || testForData == null ){\r\nreturn 0;\r\n}\r\nvar GameSessionStates = $prop('variable.GameSessionStates')\r\nvar sessionState = GameSessionStates.sessionState;\r\nvar gameState = GameSessionStates.gameState;\r\n\r\nif (gameState == \"GAME_EXITED\" || gameState == \"GAME_FRONT_END\" || gameState == \"GAME_FRONT_END\" || gameState == \"GAME_INGAME_INMENU_TIME_TICKING\"){\r\nreturn false;\r\n}\r\nvar totalLaps = $prop('TotalLaps')\r\nvar thisLap = drivercurrentlap(1)\r\n//var timeLeft = $prop('SessionTimeLeft')\r\n// NewRawData().sRaceData.sLapsTimeInEvent\r\nvar timeLeft = NewRawData().sTimingsData.sEventTimeRemaining\r\nvar replayTimeLeft = $prop('CurrentLapTime')\r\n\r\n// Destructure the properties from the object\r\nvar { gameState, sessionState } = $prop('variable.GameSessionStates');\r\nvar info = $prop('GameRawData.sRaceData.sLapsTimeInEvent');\r\nvar isTimedSession = (info & 0x8000) !== 0;\r\nvar value = info & 0x7FFF;\r\n\r\nif(sessionState == \"SESSION_PRACTICE\"){\r\nreturn secondstotimespan(timeLeft);\r\n}\r\nif(sessionState == \"SESSION_QUALIFY\"){\r\nreturn secondstotimespan(timeLeft);\r\n}\r\nif(sessionState == \"SESSION_RACE\" && gameState == \"GAME_FRONT_END_REPLAY\"  ){\r\nreturn false; //no elapsed ot total event times are available in replay, this is a dirty hack to show something\r\n}\r\nif(isTimedSession == true){\r\nreturn secondstotimespan(timeLeft);\r\n}\r\nvar lapsRemaining = $prop('TotalLaps')\r\nreturn secondstotimespan(lapsRemaining)"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.GroupItem, SimHub.Plugins","ChildsPositioning":0,"ChildsPositioningAlignment":0,"GroupPadding":{},"ChildsMargin":{},"ChildAlignmentHorizontal":0,"ChildAlignmentVertical":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.Layer, SimHub.Plugins","Group":false,"Repetitions":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.ImageItem, SimHub.Plugins","Image":"checkered","AutoSize":false,"BackgroundColor":"#FFFFFFFF","Height":62.0,"Left":0.0,"Opacity":50.0,"Top":0.0,"Visible":true,"Width":82.0,"Name":"Checkered Flag","RenderingSkip":50,"MinimumRefreshIntervalMS":500.0,"Bindings":{"Visible":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"// Retrieve the main data object which includes all nested data structures\r\nvar combined = $prop('variable.driverData');\r\n\r\n// Extract the 'driverData' array from the combined data object\r\nvar driverData = combined[\"driverData\"];\r\n\r\n// Initialize variables to hold the specific driver's current time and current lap\r\nvar currentTime = null;\r\nvar currentLap = null;\r\n\r\n// Loop through driver data to find the driver who is in first place (RacePosition 1)\r\nfor (var i = 0; i < driverData.length; i++) {\r\n    if (driverData[i].racePosition === 1) { // Check if the driver's race position is 1\r\n        currentTime = driverData[i].currentTime;\r\n        currentLap = driverData[i].currentLap;\r\n        break; // Exit the loop once the first-position driver is found\r\n    }\r\n}\r\n\r\n// The currentTime and currentLap are now set to the found values or remain null if no match was found\r\nvar totalLaps = $prop('TotalLaps');\r\nvar thisLap = currentLap;\r\nvar timeLeft = timespantoseconds($prop('SessionTimeLeft'));\r\n\r\n// Destructure the properties from the object\r\nvar { gameState, sessionState } = $prop('variable.GameSessionStates');\r\nvar info = $prop('GameRawData.sRaceData.sLapsTimeInEvent');\r\nvar isTimedSession = (info & 0x8000) !== 0;\r\nvar value = info & 0x7FFF;\r\n\r\nif (isTimedSession) {\r\n    if (timeLeft <= 0 && root[\"raceEnded\"] == 0) {\r\n        root[\"raceEnded\"] = thisLap;\r\n    }\r\n\r\n    if (timeLeft <= 0 && root[\"raceEnded\"] != thisLap) {\r\n        return 1;\r\n    }\r\n} else {\r\n    if (thisLap == totalLaps + 1) {\r\n        return 1;\r\n    }\r\n}\r\nreturn 0;","PreExpression":"root[\"raceEnded\"] = 0;"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Secular One","FontWeight":"Bold","FontSize":20.0,"Text":"Last Lap","TextColor":"#FF000000","HorizontalAlignment":1,"VerticalAlignment":1,"CharWidth":7.0,"SpecialCharsWidth":19.0,"BackgroundColor":"#FFFFFFFF","BorderStyle":{"BorderColor":"#00FFFFFF"},"Height":61.0,"Left":0.0,"Opacity":47.0,"Top":0.0,"Visible":true,"Width":82.0,"Name":"Last Lap","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Visible":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"// Retrieve the main data object which includes all nested data structures\r\nvar combined = $prop('variable.driverData');\r\n\r\n// Extract the 'driverData' array from the combined data object\r\nvar driverData = combined[\"driverData\"];\r\n\r\n// Initialize variables to hold the specific driver's current time and current lap\r\nvar currentTime = null;\r\nvar currentLap = null;\r\nvar fastestLapTime= null\r\n\r\n// Loop through driver data to find the driver who is in first place (RacePosition 1)\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t   \r\nfor (var i = 0; i < driverData.length; i++) {\r\n    if (driverData[i].racePosition === 1) { // Check if the driver's race position is 1\r\n        currentTime = driverData[i].currentTime;\r\n        currentLap = driverData[i].currentLap;\r\n        fastestLapTime = driverData[i].fastestLapTime;\r\n        break; // Exit the loop once the first-position driver is found\r\n    }\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   \r\n}\r\n\r\n\r\nvar totalLaps = $prop('TotalLaps');\r\nvar thisLap = currentLap;\r\n//reset flags for replay scrubbing\r\nif (thisLap < root[\"noMore\"] ){\r\nroot[\"noMore\"] = 0;\r\nroot[\"raceEnded\"] = 0;\r\n}\r\n//return fastestLapTime\r\nvar timeLeft = timespantoseconds($prop('SessionTimeLeft'));\r\n//return timeLeft\r\n// Destructure the properties from the object\r\nvar { gameState, sessionState } = $prop('variable.GameSessionStates');\r\nvar info = $prop('GameRawData.sRaceData.sLapsTimeInEvent');\r\nvar isTimedSession = (info & 0x8000) !== 0;\r\nvar value = info & 0x7FFF;\r\n\r\nif(isTimedSession == true){\r\nif (timeLeft <= 0 && root[\"raceEnded\"] == 0 ){\r\nroot[\"raceEnded\"] = thisLap;\r\n}\r\n}\r\n//return root[\"raceEnded\"]\r\nif (timeLeft - fastestLapTime <=0 && isTimedSession == true && root[\"noMore\"] ==0 ){\r\nroot[\"noMore\"] = thisLap;\r\n}\r\n//return root[\"noMore\"];\r\nif (root[\"noMore\"]!= 0 && root[\"noMore\"] - thisLap !=0 && root[\"noMore\"] - thisLap >=-1){\r\nreturn true;\r\n}\r\nif(isTimedSession != true){\r\nif (thisLap == totalLaps ){\r\nreturn true;// + \" \" + currentTime + \" \" + currentLap;\r\n}\r\n}\r\nreturn false","PreExpression":"root[\"noMore\"] = 0\r\nroot[\"raceEnded\"] = 0;"},"Mode":2},"TextColor":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"if(root[\"direction\"] == \"up\"){\r\nroot[\"fade\"] ++;\r\n}\r\nif(root[\"direction\"] == \"down\"){\r\nroot[\"fade\"] --;\r\n}\r\nif(root[\"fade\"] >= 150){\r\nroot[\"direction\"] 