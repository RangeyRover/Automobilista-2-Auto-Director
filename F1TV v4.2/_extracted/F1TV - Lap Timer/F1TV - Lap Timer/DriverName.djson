                          "Name": "Knockout Zone",
                          "RenderingSkip": 0,
                          "Sid": 0,
                          "Bindings": {
                            "$id": "33",
                            "Visible": {
                              "$id": "34",
                              "Formula": {
                                "$id": "35",
                                "Expression": "'Q2\r\n\r\nif([GameRawData.PacketSessionData.m_sessionType]=6 and [OpponentsCount]=16 and [GarySwallowDataPlugin.Leaderboard.Position10.BestLap]>0 and [Position]>10 and [Position]<17,1,\r\n\r\nif([GameRawData.PacketSessionData.m_sessionType]=6 and [OpponentsCount]=15 and [GarySwallowDataPlugin.Leaderboard.Position10.BestLap]>0 and [Position]>10 and [Position]<16,1,\r\n'Q1\r\n\r\nif([GameRawData.PacketSessionData.m_sessionType]=5 and [OpponentsCount]=22 and [GarySwallowDataPlugin.Leaderboard.Position16.BestLap]>0 and [Position]>16 and [Position]<23,1,\r\n\r\nif([GameRawData.PacketSessionData.m_sessionType]=5 and [OpponentsCount]=20 and [GarySwallowDataPlugin.Leaderboard.Position16.BestLap]>0 and [Position]>15 and [Position]<21,1,0))))"
                              },
                              "Mode": 2,
                              "TargetPropertyName": "Visible"
                            }
                          }
                        },
                        {
                          "$id": "36",
                          "$type": "SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins",
                          "IsTextItem": true,
                          "ShadowDepth": 0,
                          "ShadowBlur": 0,
                          "ShadowDirection": 315,
                          "ShadowColor": "#FF808080",
                          "Font": "F1TV-2022-ObliqueBold-Pos",
