                          "Width": 80.0,
                          "BorderBottom": 0,
                          "BorderColor": "#FF242326",
                          "BorderLeft": 0,
                          "BorderRight": 0,
                          "BorderTop": 0,
                          "Id": "000598cc-1e32-479e-9739-2b108c936b4e",
                          "IsFreezed": false,
                          "IsSelected": false,
                          "Name": "Position",
                          "RenderingSkip": 0,
                          "Sid": 0,
                          "Bindings": {
                            "$id": "39",
                            "Text": {
                              "$id": "40",
                              "Formula": {
                                "$id": "41",
                                "Expression": "if([GameRawData.PacketSessionData.m_sessionType]=7,[Position],\r\n\r\n\r\nif([GameRawData.PacketSessionData.m_sessionType]=6 and  [GarySwallowDataPlugin.Leaderboard.Position10.BestLap]>0,[Position],\r\n\r\nif([GameRawData.PacketSessionData.m_sessionType]=5 and  [GarySwallowDataPlugin.Leaderboard.Position15.BestLap]>0,[Position],\r\n\r\n\r\nif([GameRawData.PacketSessionData.m_sessionType]>4 and [GameRawData.PacketSessionData.m_sessionType]<9 and [GarySwallowDataPlugin.ObservedDriver.BestLap]=0,'–',\r\n\r\n\r\n[Position]))))"
                              },
                              "Mode": 2,
                              "TargetPropertyName": "Text"
                            },
                            "TextColor": {
                              "$id": "42",
                              "Formula": {
                                "$id": "43",
                                "Expression": "if(\r\n\r\n'Q2\r\n\r\nif([OpponentsCount]=16 and [GarySwallowDataPlugin.Leaderboard.Position10.BestLap]>0 and [Position]>10 and [Position]<17,1,\r\n\r\nif([OpponentsCount]=15 and [GarySwallowDataPlugin.Leaderboard.Position10.BestLap]>0 and [Position]>10 and [Position]<16,1,\r\n'Q1\r\n\r\nif([OpponentsCount]=22 and [GarySwallowDataPlugin.Leaderboard.Position16.BestLap]>0 and [Position]>16 and [Position]<23,1,\r\n\r\nif([OpponentsCount]=20 and [GarySwallowDataPlugin.Leaderboard.Position16.BestLap]>0 and [Position]>15 and [Position]<21,1,0)))) ==1,'White','Silver')"
                              },
                              "Mode": 2,
                              "TargetPropertyName": "TextColor"
                            }
                          }
                        },
