                            "TextColor": {
                              "$id": "56",
                              "Formula": {
                                "$id": "57",
                                "Expression": "if([GarySwallowDataPlugin.ObservedDriver.Team]='Red Bull Racing','#1F5BC6',if([GarySwallowDataPlugin.ObservedDriver.Team]='Mercedes','#6CD3BF',if([GarySwallowDataPlugin.ObservedDriver.Team]='Ferrari','#ED1B24',if([GarySwallowDataPlugin.ObservedDriver.Team]='McLaren','#F48020',if([GarySwallowDataPlugin.ObservedDriver.Team]='Alpine','#2193D1',if([GarySwallowDataPlugin.ObservedDriver.Team]='Alpha Tauri','#4E7D9B',if([GarySwallowDataPlugin.ObservedDriver.Team]='Alfa Romeo','#B02039',if([GarySwallowDataPlugin.ObservedDriver.Team]='Aston Martin','#2D826D',if([GarySwallowDataPlugin.ObservedDriver.Team]='Haas','#B6BABD',if([GarySwallowDataPlugin.ObservedDriver.Team]='Williams','#37BEDC',if([GarySwallowDataPlugin.ObservedDriver.Team]=[GarySwallowDataPlugin.Generic.F12021MyTeam.CustomTeamName],[GarySwallowDataPlugin.Generic.F12021MyTeam.CustomTeamColour],'transparent')))))))))))"
                              },
                              "Mode": 2,
                              "TargetPropertyName": "TextColor"
                            },
                            "FontSize": {
                              "$id": "58",
                              "Formula": {
                                "$id": "59",
                                "Expression": "if(\r\n\r\nright([GarySwallowDataPlugin.ObservedDriver.DriverName.LastNameLong]\r\n, 10, 1)!='',30,\r\n\r\nif(\r\n\r\nright([GarySwallowDataPlugin.ObservedDriver.DriverName.LastNameLong]\r\n, 9, 1)!='',32,34))"
                              },
                              "Mode": 2,
                              "TargetPropertyName": "FontSize"
                            }
                          }
