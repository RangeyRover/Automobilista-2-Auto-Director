\r\n\tcase \"brauchen9\":  {\r\n\treturn \"Renault\"\r\n\tbreak;\r\n\t}\r\n\tcase \"jrookareenz\":  {\r\n\treturn \"Renault\"\r\n\tbreak;\r\n\t}\r\n\tcase \"abc123\": {\r\n\treturn \"Toro Rosso\"\r\n\tbreak;\r\n\t}\r\n\tcase \"\":  {\r\n\treturn \"Toro Rosso\"\r\n\tbreak;\r\n\t}\r\n\tcase \"\":  {\r\n\treturn \"Force India\"\r\n\tbreak;\r\n\t}\r\n\tcase \"\": {\r\n\treturn \"Force India\"\r\n\tbreak;\r\n\t}\r\n\tcase \"TTAR\": {\r\n\treturn \"Sauber\"\r\n\tbreak;\r\n\t}\r\n\tcase \"orangetrptboi\": {\r\n\treturn \"Sauber\"\r\n\tbreak;\r\n\t}\r\n\tcase \"Arty94\": {\r\n\treturn \"Haas\"\r\n\tbreak;\r\n\t}\r\n\tcase \"CrackaColdone\": {\r\n\treturn \"Haas\"\r\n\tbreak;\r\n\t}\t\r\n\tcase \"Rick Ardow\": {\r\n\treturn \"Williams\"\r\n\tbreak;\r\n\t}\r\n\tcase \"Enigma\": {\r\n\treturn \"Williams\"\r\n\tbreak;\t\r\n\t}\r\n\tcase \"\": {\r\n\treturn \"Manor Racing\"\r\n\tbreak;\t\r\n\t}\r\n\tcase \"\": {\r\n\treturn \"Manor Racing\"\r\n\tbreak;\t\r\n\t}\r\n\t\r\n\r\n\r\n\tdefault: {\r\n\treturn \"MM\"\r\n\t}\r\n\r\n\r\n\r\n}"},"Mode":2}}}],"Visible":true,"BlinkPhasisInverted":false,"Name":"Team","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.Layer, SimHub.Plugins","Group":false,"Repetitions":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"KH Interference","FontWeight":"Bold","FontSize":50.0,"Text":"Shattered.Compass","TextColor":"#FF000000","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":75.0,"Left":147.0,"Top":3.0,"Visible":true,"BlinkPhasisInverted":false,"Width":592.0,"Name":"Driver","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"// Step 1: Get the current position\r\nlet position = $prop('AMS2Replay.AMS2.DriverInFocus.RacePosition');\r\n\r\n// Validate the position\r\nif (typeof position !== 'number' || position < 1 || position > 32) {\r\n  position = root[\"lastValidRacePosition\"];\r\n} else {\r\n  root[\"lastValidRacePosition\"] = position;\r\n}\r\n\r\n// Step 2: Try to get the driver name\r\nlet driverName = $prop('AMS2Replay.AMS2.DriverInFocus.Name')\r\n\r\n// Step 3: Check if it's valid\r\nif (driverName && driverName.trim() !== \"\") {\r\n  // Step 4: Use provisional match logic\r\n  if (root[\"provisionalDriverName\"] === driverName) {\r\n    // Confirmed twice in a row: update the official value\r\n    root[\"lastValidDriverName\"] = driverName;\r\n  } else {\r\n    // First time seeing this name — store it provisionally\r\n    root[\"provisionalDriverName\"] = driverName;\r\n  }\r\n}\r\n\r\n// Step 5: Return the last confirmed good name\r\nreturn root[\"lastValidDriverName\"] || \"-\";"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"KH Interference","FontWeight":"Bold","FontSize":39.0,"Text":"4","TextColor":"#FF000000","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":75.0,"Left":2.0,"Top":4.0,"Visible":true,"BlinkPhasisInverted":false,"Width":70.0,"Name":"Pos","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"// Step 1: Get current position\r\nlet position = $prop('AMS2Replay.AMS2.DriverInFocus.RacePosition');\r\n\r\n// Step 2: Validate input and use double-confirmation\r\nif (typeof position === 'number' && position >= 1 && position <= 32) {\r\n  if (root[\"provisionalRacePosition\"] === position) {\r\n    root[\"lastValidRacePosition\"] = position;\r\n  } else {\r\n    root[\"provisionalRacePosition\"] = position;\r\n  }\r\n}\r\n\r\n// Step 3: Use last confirmed valid position\r\nlet finalPosition = root[\"lastValidRacePosition\"];\r\n\r\n// Step 4: Return formatted output or fallback\r\nif (finalPosition) {\r\n  return finalPosition;\r\n} else {\r\n  return '-';\r\n}"},"Mode":2}}}],"Visi