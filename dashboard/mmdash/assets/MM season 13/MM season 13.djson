] = targetDriver;\r\n  } else {\r\n    root[\"provisionalGapDriver\"] = targetDriver;\r\n  }\r\n}\r\n\r\n// Return result\r\nreturn (root[\"lastValidGapDriver\"] || \"-\");"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"KH Interference","FontWeight":"Light","FontStyle":"Italic","FontSize":29.0,"Text":"ShatteredCompass","TextColor":"#FFFFFF00","HorizontalAlignment":0,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":35.0,"Left":290.0,"Top":78.0,"Visible":true,"BlinkPhasisInverted":false,"Width":410.0,"Name":"Driver Ahead","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"let position = $prop('AMS2Replay.AMS2.DriverInFocus.RacePosition');\r\n\r\n// Validate and store last good position\r\nif (typeof position !== 'number' || position < 1 || position > 32) {\r\n  position = root[\"lastValidRacePosition\"];\r\n} else {\r\n  root[\"lastValidRacePosition\"] = position;\r\n}\r\n\r\nlet targetPosition;\r\n\r\n// Special case: if leader, show gap to 2nd place\r\nif (position === 1) {\r\n  root[\"lastValidGapDriver\"] = \"-\";\r\n} else {\r\n  targetPosition = position - 1;\r\n}\r\n\r\n\r\n// Get the target driver name\r\nlet targetDriver = $prop(`AMS2Replay.AMS2.RacePosition${targetPosition}.Name`);\r\n\r\n// Validate name and apply double-confirmation\r\nif (targetDriver && targetDriver.trim() !== \"\") {\r\n  if (root[\"provisionalGapDriver\"] === targetDriver) {\r\n    root[\"lastValidGapDriver\"] = targetDriver;\r\n  } else {\r\n    root[\"provisionalGapDriver\"] = targetDriver;\r\n  }\r\n}\r\n\r\n// Return result\r\nreturn (root[\"lastValidGapDriver\"] || \"-\");"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"KH Interference","FontSize":30.0,"Text":"+5.42","TextColor":"#FFFFFF00","HorizontalAlignment":1,"VerticalAlignment":1,"Background