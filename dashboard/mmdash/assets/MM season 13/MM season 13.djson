n  \r\n  return \"-\";\r\n}\r\nelse {\r\n  currentSplit = $prop('AMS2Replay.AMS2.SplitTimeBehind');  // Looking ahead otherwise\r\n}\r\n\r\n// Init root variable if not set\r\nif (root[\"savedSplitTime\"] == null) {\r\n  root[\"savedSplitTime\"] = \"+\";\r\n}\r\n\r\n// If valid, update cache and return formatted split\r\nif (currentSplit != -1 && typeof currentSplit === \"number\") {\r\n  root[\"savedSplitTime\"] = sign + currentSplit.toFixed(1) + \"s\";\r\n  return root[\"savedSplitTime\"];\r\n} else {\r\n  return root[\"savedSplitTime\"];\r\n}"},"Mode":2}}}],"Visible":true,"BlinkPhasisInverted":false,"Name":"Gaps","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.Layer, SimHub.Plugins","Group":false,"Repetitions":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"KH Interference","FontWeight":"Medium","FontSize":36.0,"Text":"Force India","TextColor":"#FFFFFFFF","HorizontalAlignment":0,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":75.0,"Left":26.0,"Top":77.0,"Visible":true,"BlinkPhasisInverted":false,"Width":268.0,"Name":"Team Name","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0,"Bindings":{"Text":{"Formula":{"JSExt":0,"Interpreter":1,"Expression":"switch ($prop('AMS2Replay.AMS2.DriverInFocus.Name'))  {\r\n\r\n\tcase \"LeClair\": {\r\n\treturn \"Mercedes\"\r\n\tbreak;\r\n\t}\r\n\tcase \"NDF\":  {\r\n\treturn \"Mercedes\"\r\n\tbreak;\r\n\t}\r\n\tcase \"D3BuG-\":  {\r\n\treturn \"Ferrari\"\r\n\tbreak;\r\n\t}\r\n\tcase \"Garrett O'Brien\":  {\r\n\treturn \"Ferrari\"\r\n\tbreak;\r\n\t}\r\n\tcase \"natedelta\":  {\r\n\treturn \"Red Bull\"\r\n\tbreak;\r\n\t}\r\n\tcase \"cumsum\":  {\r\n\treturn \"Red Bull\"\r\n\tbreak;\r\n\t}\r\n\tcase \"Shattered.Compass\":  {\r\n\treturn \"Mclaren\"\r\n\tbreak;\r\n\t}\r\n\tcase \"cloning888\": {\r\n\treturn \"Mclaren\"\r\n\tbreak;\r\n\t}\r\n\tcase \"brauchen9\":  {\r\n\treturn \"Renaul