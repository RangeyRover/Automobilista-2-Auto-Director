{"Variables":{"DashboardVariables":[{"VariableName":"racePosition","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"JSExt":0,"Interpreter":1,"Expression":"\r\nvar racePosition = $prop('AMS2Replay.AMS2.DriverInFocus.RacePosition');\r\n// need if\r\nvar driverName = $prop('AMS2Replay.AMS2.DriverInFocus.Name')\r\n\r\n// Return racePosition and driverName as an object\r\nreturn {\r\n    racePosition: racePosition,\r\n    driverName: driverName\r\n};\r\n"},"EvaluateBeforeScreenRoles":false},{"VariableName":"DriverAhead","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"JSExt":0,"Interpreter":1,"Expression":"var driverAhead = $prop('AMS2Replay.AMS2.DriverInFocus.RacePosition')-1\r\nif (driverAhead === 0) {\r\n  return null;\r\n}\r\nvar driverAheadName = $prop(\"AMS2Replay.AMS2.RacePosition\" + driverAhead + \".Name\");\r\nreturn driverAheadName"},"EvaluateBeforeScreenRoles":false},{"VariableName":"gap","EvaluateOnlyOnce":false,"OverrideWithParentDashboardVariableWhenAvailable":true,"ValueExpression":{"JSExt":0,"Interpreter":1,"Expression":"var splitBehind =$prop('AMS2Replay.AMS2.SplitTimeBehind')\r\nvar splitAhead = $prop('AMS2Replay.AMS2.SplitTimeAhead')\r\nvar driverFocus = $prop('AMS2Replay.AMS2.DriverInFocus.RacePosition')\r\nif (driverFocus ==1) {\r\nreturn splitBehind;\r\n}\r\nreturn splitAhead\r\n"},"EvaluateBeforeScreenRoles":false}]},"DashboardDebugManager":{"WindowPositionSettings":{"IsFullScreen":false,"Position":"465,25,2336,1314","TopMost":false,"AllowTransparency":true,"CloseOnMonitorLoss":false,"NoWindowActivate":false}},"Version":2,"Id":"0deda1b6-ca68-435a-a9de-70bd88f56d9f","BaseHeight":1080,"BaseWidth":1920,"BackgroundColor":"#FF000000","Screens":[{"RenderingSkip":0,"Name":"Screen","InGameScreen":true,"IdleScreen":false,"PitScreen":false,"ScreenId":"f8b1829c-7cbd-48ea-8a2e-a0ecba832670","AllowOverlays":true,"IsForegroundLayer":false,"IsOverlayLayer":false,"OverlayTriggerExpression":{"Expression":""},"ScreenEnabledExpression":{"JSExt":0,"Interpreter":1,"Expression":"var testForData = $prop('variable.rxUDP')\r\nif(testForData == 0 || testForData == null ){\r\nreturn 0;\r\n}\r\nvar GameSessionStates = $prop('variable.GameSessionStates')\r\nvar sessionState = GameSessionStates.sessionState;\r\nif (sessionState == \"SESSION_RACE\"){\r\nreturn true;\r\n}\r\nreturn false"},"OverlayMaxDuration":0,"OverlayMinDuration":0,"IsBackgroundLayer":false,"BackgroundColor":"#00FFFFFF","Items":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.Layer, SimHub.Plugins","Group":true,"Repetitions":0,"Childrens":[{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.ImageItem, SimHub.Plugins","Image":"UI1","AutoSize":true,"BackgroundColor":"#00FFFFFF","Height":139.0,"Left":769.0,"Top":827.0,"Visible":true,"BlinkPhasisInverted":false,"Width":490.0,"Name":"ImageItem","RenderingSkip":0,"MinimumRefreshIntervalMS":0.0},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Rescue W01","FontWeight":"SemiBold","FontSize":18.0,"Text":"Battle for 2nd","TextColor":"#FF808080","HorizontalAlignment":1,"VerticalAlignment":1,"BackgroundColor":"#00FFFFFF","Height":40.0,"Left":1056.0,"Top":895.0,"Visible":true,"BlinkPhasisInverted":false,"Width":150.0,"Name":"Battle for Xth","RenderingSkip":10,"MinimumRefreshIntervalMS":100.0,"Bindings":{"Text":{"Formula":{"JSExt":3,"Interpreter":1,"Expression":"var racePosition = $prop('AMS2Replay.AMS2.DriverInFocus.RacePosition')\r\nvar pos = racePosition - 1; \r\nvar type = \"\"; \r\n\r\nif (pos == 1){type = \"st\"}\r\nif (pos == 2){type = \"nd\"}\r\nif (pos == 3){type = \"rd\"}\r\nif (pos == 4){type = \"th\"}\r\nif (pos == 5){type = \"th\"}\r\nif (pos == 6){type = \"th\"}\r\nif (pos == 7){type = \"th\"}\r\nif (pos == 8){type = \"th\"}\r\nif (pos == 9){type = \"th\"}\r\nif (pos == 10){type = \"th\"}\r\nif (pos == 11){type = \"th\"}\r\nif (pos == 12){type = \"th\"}\r\nif (pos == 13){type = \"th\"}\r\nif (pos == 14){type = \"th\"}\r\nif (pos == 15){type = \"th\"}\r\nif (pos == 16){type = \"th\"}\r\nif (pos == 17){type = \"th\"}\r\nif (pos == 18){type = \"th\"}\r\nif (pos == 19){type = \"th\"}\r\nif (pos == 20){type = \"th\"}\r\nif (pos == 21){type = \"st\"}\r\nif (pos == 22){type = \"nd\"}\r\nif (pos == 23){type = \"rd\"}\r\nif (pos == 24){type = \"th\"}\r\nif (pos == 25){type = \"th\"}\r\nif (pos == 26){type = \"th\"}\r\nif (pos == 27){type = \"th\"}\r\nif (pos == 28){type = \"th\"}\r\nif (pos == 29){type = \"th\"}\r\nif (pos == 30){type = \"th\"}\r\n\r\nif (pos == 0){\r\nreturn \"Leader\";\r\n}\r\nreturn \"Battle for \" + pos + type;"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Rescue W01","TextPadding":{"PaddingTop":2,"PaddingBottom":2,"PaddingLeft":2,"PaddingRight":2},"FontSize":18.0,"Text":"12345678901234567890","TextColor":"#FFFFFFFF","HorizontalAlignment":0,"VerticalAlignment":0,"BackgroundColor":"#00FFFFFF","Height":39.0,"Left":799.0,"Top":874.0,"Visible":true,"BlinkPhasisInverted":false,"Width":200.0,"Name":"Driver Name2","RenderingSkip":10,"MinimumRefreshIntervalMS":100.0,"Bindings":{"Text":{"Formula":{"JSExt":3,"Interpreter":1,"Expression":"var name = $prop('AMS2Replay.AMS2.DriverInFocus.Name')\r\nreturn name"},"Mode":2},"FontSize":{"Formula":{"JSExt":3,"Interpreter":1,"Expression":"var name = $prop('AMS2Replay.AMS2.DriverInFocus.Name')\r\nvar length = name.length; // Calculate the length of the driver's name\r\n\r\nif (length >= 13) {\r\n    return Math.round(18 * (13 / length));\r\n}\r\nreturn 18;"},"Mode":2}}},{"$type":"SimHub.Plugins.OutputPlugins.GraphicalDash.Models.TextItem, SimHub.Plugins","IsTextItem":true,"Font":"Rescue W01","FontWeight":"Medium","TextPadding":{"PaddingTop":2,"PaddingBottom":2,"PaddingLeft":2,"PaddingRight":2},"FontSize":18.0,"Text":"0.12s","TextColor":"#FF000000","HorizontalAlignment":2,"Vert